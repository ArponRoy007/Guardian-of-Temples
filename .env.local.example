# Supabase Public API Configuration
# Find these in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Private Service Role Key (Keep secret! Only use in server-side administrative code/API routes)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# FIREBASE ADMIN SECRETS
FIREBASE_PROJECT_ID="copy_the_project_id_value_here"
FIREBASE_CLIENT_EMAIL="copy_the_client_email_value_here"
FIREBASE_PRIVATE_KEY="copy_the_huge_private_key_value_here"
